{
  "expo": {
    "name": "CellarLog",
    "slug": "cellarlog",
    "scheme": "cellarlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cellarlog.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cellarlog.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "CellarLog uses the microphone so you can speak your cellar notes.",
          "speechRecognitionPermission": "CellarLog turns your spoken notes into text on this phone.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
