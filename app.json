{
  "expo": {
    "name": "EnoLog",
    "slug": "cellarlog",
    "scheme": "cellarlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.enolog.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "EnoLog turns your spoken notes into text on this phone.",
        "NSMicrophoneUsageDescription": "EnoLog uses the microphone so you can speak your cellar notes."
      }
    },
    "android": {
      "package": "com.enolog.app",
      "adaptiveIcon": {
        "backgroundColor": "#4A1322",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6B1F33"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "EnoLog uses the microphone so you can speak your cellar notes.",
          "speechRecognitionPermission": "EnoLog turns your spoken notes into text on this phone.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A1322",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#2A0E17",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d1cc088-ae96-4b47-9039-b6ce058ed900"
      }
    },
    "owner": "meno-g"
  }
}
