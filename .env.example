# Copy this file to .env and fill in the values. .env is gitignored.
# Everything prefixed EXPO_PUBLIC_ is built into the app bundle and readable
# by anyone who has the app: never put private server secrets here.
# After editing .env, restart with: npx expo start --clear

# Supabase dashboard -> Project Settings -> API (Data API / API Keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key.
# Safe to ship in the app: Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
